# Copying this file is optional. `make ngrok-config domain=...` creates the
# real, gitignored `.env.ngrok` with random secrets and mode 0600.

# Assigned development domain from the ngrok dashboard. Host name only.
PEERXIV_NGROK_DOMAIN=your-domain.ngrok-free.app

# Generate two independent values with Python's secrets module. The alpha code
# is an emergency bootstrap secret; create individual invitations for testers.
PEERXIV_SECRET_KEY=replace-with-at-least-32-random-characters
PEERXIV_ALPHA_INVITE_CODE=replace-with-a-separate-random-invite-code
PEERXIV_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key

# The invite-only tunnel uses PDF structural validation and reconstruction but
# does not require a local ClamAV daemon. Do not use this profile for open
# public submissions.
PEERXIV_MALWARE_SCAN_REQUIRED=0

# Optional ORCID sandbox integration. The redirect URI must exactly match a
# URI registered for the ORCID Public API client.
PEERXIV_ORCID_ENVIRONMENT=sandbox
PEERXIV_ORCID_CLIENT_ID=
PEERXIV_ORCID_CLIENT_SECRET=
PEERXIV_ORCID_REDIRECT_URI=https://your-domain.ngrok-free.app/api/v1/accounts/orcid/callback

# Zenodo starts in its separate sandbox. Researchers connect their own token
# through PeerXiv; the token is encrypted with the key above.
PEERXIV_ZENODO_ENVIRONMENT=sandbox
PEERXIV_ZENODO_ALLOW_PRODUCTION_PUBLISH=0

# Optional overrides. The defaults keep both files under the gitignored
# `instance/` directory and bind Gunicorn only to the loopback interface.
# PEERXIV_NGROK_DATABASE_URL=sqlite:////absolute/path/to/peerxiv.sqlite3
# PEERXIV_NGROK_MANUSCRIPT_STORAGE_ROOT=/absolute/path/to/manuscripts
# PEERXIV_NGROK_PORT=8000
