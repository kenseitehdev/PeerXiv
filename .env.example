# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PEERXIV_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PEERXIV_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key
PEERXIV_REGISTRATION_MODE=invite
PEERXIV_ALPHA_INVITE_CODE=replace-with-a-separate-random-invite-code
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Exact public host names accepted by Flask. Do not include a scheme.
PEERXIV_TRUSTED_HOSTS=localhost,127.0.0.1

# Optional extra Socket.IO origins. Leave unset for same-origin-only deployments.
PEERXIV_FRONTEND_ORIGINS=http://localhost:8000
PEERXIV_PORT=8000

# Optional verified ORCID sign-in and account linking. Register a Public API
# client at ORCID, then register this exact callback URL with that client.
PEERXIV_ORCID_ENVIRONMENT=sandbox
PEERXIV_ORCID_CLIENT_ID=
PEERXIV_ORCID_CLIENT_SECRET=
PEERXIV_ORCID_REDIRECT_URI=http://127.0.0.1:8000/api/v1/accounts/orcid/callback

# Optional per-researcher Zenodo DOI deposits. Keep production publication
# disabled until the complete sandbox reserve/publish workflow has passed.
PEERXIV_ZENODO_ENVIRONMENT=sandbox
PEERXIV_ZENODO_ALLOW_PRODUCTION_PUBLISH=0

# Production uploads fail closed if the private ClamAV service is unavailable.
PEERXIV_CLAMAV_HOST=clamav
PEERXIV_CLAMAV_PORT=3310
PEERXIV_MALWARE_SCAN_REQUIRED=1

# Enable only behind the exact number of trusted reverse proxies configured by
# PEERXIV_PROXY_X_*; never enable this for a directly exposed process.
PEERXIV_PROXY_FIX=0
